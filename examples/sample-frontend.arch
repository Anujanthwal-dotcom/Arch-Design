        }
      ],
      "parameters": [],
      "returns": [],
      "isCollapsed": false
    },
    {
      "id": "f1",
      "type": "function",
      "label": "formatCurrency",
      "pos": {
        "x": 1320,
        "y": 60
      },
      "description": "Formats raw numeric price into localized currency string",
      "properties": [],
      "parameters": [
        {
          "id": "param1",
          "name": "amount",
          "type": "number",
          "required": true,
          "description": "Raw price in cents or dollars"
        },
        {
          "id": "param2",
          "name": "currency",
          "type": "string",
          "required": false,
          "description": "ISO currency code, defaults to USD"
        }
      ],
      "returns": [
        {
          "id": "ret1",
          "name": "formatted",
          "type": "string",
          "required": true,
          "description": "Localized currency string e.g. $19.99"
        }
      ],
      "isCollapsed": false
    },
    {
      "id": "e1",
      "type": "external",
      "label": "StoreAPI",
      "pos": {
        "x": 480,
        "y": 458
      },
      "description": "Backend REST endpoints for products and cart checkout",
      "properties": [],
      "parameters": [],
      "returns": [],
      "tech": "rest",
      "isCollapsed": false
    },
    {
      "id": "t1",
      "type": "type",
      "label": "ProductDTO",
      "pos": {
        "x": 480,
        "y": 716
      },
      "description": "Typed data contract representing a store product item",
      "subType": "interface",
      "properties": [
        {
          "id": "p4",
          "title": "Fields",
          "description": "id: string, name: string, price: number, inStock: boolean"
        }
      ],
      "parameters": [],
      "returns": [],
      "isCollapsed": false
    }
  ],
  "edges": [
