{
  "name": "arch-for-LLD-design",
  "publisher": "AnujAnthwal",
  "displayName": "Arch Design",
  "description": "Visual architecture canvas for mapping Backend, Frontend, Mobile (Android/iOS), and Systems (Rust) architectures",
  "icon": "media/icon.png",
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.74.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Anujanthwal-dotcom/Arch-Design"
  },
  "homepage": "https://anujanthwal-dotcom.github.io/Arch-Design/",
  "categories": [
    "Visualization",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "arch",
    "architecture",
    "system-design",
    "low-level-design",
    "frontend",
    "mobile",
    "android",
    "ios",
    "rust",
    "diagram",
    "canvas",
    "software-design"
  ],
  "activationEvents": [
    "onCustomEditor:lldCanvas.editor",
    "onCommand:lldCanvas.newFile",
    "onCommand:lldCanvas.initAgentSkill"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "arch",
        "aliases": [
          "Arch",
          "arch"
        ],
        "extensions": [
          ".arch",
          ".lld"
        ],
        "icon": {
          "light": "./media/icons/arch-light.svg",
          "dark": "./media/icons/arch-dark.svg"
        }
      }
    ],
    "commands": [
      {
        "command": "lldCanvas.newFile",
        "title": "New Architecture File",
        "category": "Arch"
      },
      {
        "command": "lldCanvas.initAgentSkill",
        "title": "Install Agent Skill",
        "category": "Arch"
      }
    ],
    "customEditors": [
      {
        "viewType": "lldCanvas.editor",
        "displayName": "Arch",
        "selector": [
          {
            "filenamePattern": "*.arch"
          },
          {
            "filenamePattern": "*.lld"
          }
        ],
        "priority": "default"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "bun run compile",
    "compile": "bun build.js",
    "package": "bunx @vscode/vsce package --no-dependencies --allow-missing-repository",
    "watch": "bun build.js --watch",
    "test": "bun test/verify.js",
    "lint": "bunx eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "16.x",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/uuid": "^9.0.7",
    "@types/vscode": "^1.74.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "esbuild": "^0.28.2",
    "eslint": "^8.56.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@types/dagre": "^0.7.54",
    "@xyflow/react": "^12.3.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "uuid": "^9.0.1"
  }
}
