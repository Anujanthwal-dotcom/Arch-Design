{
  "version": 2,
  "domain": "systems",
  "name": "tokio-hyper",
  "description": "Production Rust Async Systems Architecture based on Tokio & Hyper (Crates, Traits, Structs, Async Tasks)",
  "nodes": [
    {
      "id": "crate-server",
      "type": "crate",
      "tier": "container",
      "label": "hyper_server",
      "description": "Core crate providing high-throughput non-blocking asynchronous HTTP service engine",
      "subType": "crate",
      "pos": {
        "x": 60,
        "y": 305
      },
      "properties": [
        {
          "id": "p1",
          "title": "edition",
          "description": "2021"
        },
        {
          "id": "p2",
          "title": "features",
          "description": "[\"full\", \"tokio-runtime\", \"http2\"]"
        }
      ]
    },
    {
      "id": "struct-config",
      "type": "struct",
      "tier": "contract",
      "label": "ServerConfig",
      "description": "Immutable server configuration containing socket binding parameters and connection pool limits",
      "subType": "struct",
      "pos": {
        "x": 460,
        "y": 75
      },
      "properties": [
        {
          "id": "p3",
          "title": "bind_addr",
          "description": "std::net::SocketAddr"
        },
        {
          "id": "p4",
          "title": "max_concurrency",
          "description": "usize"
        },
        {
          "id": "p5",
          "title": "keep_alive",
          "description": "std::time::Duration"
        }
      ]
    },
    {
      "id": "struct-conn-mgr",
      "type": "struct",
      "tier": "contract",
      "label": "ConnectionManager",
      "description": "Actor-like struct coordinating incoming TCP connection dispatching across Tokio worker threads",
      "subType": "struct",
      "pos": {
        "x": 460,
        "y": 305
      },
      "properties": [
        {
          "id": "p6",
          "title": "listener",
          "description": "tokio::net::TcpListener"
        },
        {
          "id": "p7",
          "title": "active_streams",
          "description": "Arc<AtomicUsize>"
        }
      ]
    },
    {
      "id": "trait-service",
      "type": "trait",
      "tier": "contract",
      "label": "HttpService",
      "description": "Tower / Hyper asynchronous Service trait contract parameterized over Request and Response",
      "subType": "trait",
      "pos": {
        "x": 860,
        "y": 418
      },
      "properties": [
        {
          "id": "p8",
          "title": "Response",
          "description": "type Response = http::Response<Body>"
        },
        {
          "id": "p9",
          "title": "call",
          "description": "fn call(&self, req: Request) -> Future<Output = Result<Response>>"
        }
      ]
    },
    {
      "id": "fn-process-stream",
      "type": "function",
      "tier": "execution",
      "label": "process_socket_stream",
      "description": "Tokio green-thread task spawned per incoming TCP connection with cancellation token",
      "subType": "tokio",
      "pos": {
        "x": 860,
        "y": 193
      },
      "properties": [
        {
          "id": "p10",
          "title": "stream",
          "description": "mut tokio::net::TcpStream"
        },
        {
          "id": "p11",
          "title": "returns",
          "description": "tokio::task::JoinHandle<Result<(), Error>>"
        }
      ]
    },
    {
      "id": "driver-tokio-io",
      "type": "external",
      "tier": "infrastructure",
      "label": "TokioEpollRuntime",
      "description": "OS kernel non-blocking I/O multiplexer (epoll on Linux, kqueue on macOS, IOCP on Windows)",
      "tech": "tokio",
      "pos": {
        "x": 460,
        "y": 515
      },
      "properties": [
        {
          "id": "p12",
          "title": "engine",
          "description": "mio::Poll event registry"
        },
        {
          "id": "p13",
          "title": "workers",
          "description": "tokio::runtime::Builder::new_multi_thread"
        }
      ]
    }
  ],
  "edges": [
    {
      "id": "edge-config-crate",
      "from": "struct-config",
      "to": "crate-server",
      "type": "declares"
    },
    {
      "id": "edge-mgr-crate",
      "from": "struct-conn-mgr",
      "to": "crate-server",
      "type": "declares"
    },
    {
      "id": "edge-trait-mgr",
      "from": "trait-service",
      "to": "struct-conn-mgr",
      "type": "implements"
    },
    {
      "id": "edge-fn-mgr",
      "from": "fn-process-stream",
      "to": "struct-conn-mgr",
      "type": "implements"
    },
    {
      "id": "edge-driver-crate",
      "from": "driver-tokio-io",
      "to": "crate-server",
      "type": "injects"
    }
  ]
}