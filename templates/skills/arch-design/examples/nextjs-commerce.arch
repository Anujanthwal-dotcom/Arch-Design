{
  "version": 2,
  "domain": "frontend",
  "name": "nextjs-commerce",
  "description": "Production Next.js App Router Architecture based on Next.js Commerce (RSC, Server Actions, Zustand, Zod)",
  "nodes": [
    {
      "id": "page-product",
      "type": "page",
      "tier": "presentation",
      "label": "ProductPage",
      "description": "React Server Component (RSC) fetching initial product metadata and streaming recommendations",
      "subType": "rsc",
      "pos": {
        "x": 60,
        "y": 743
      },
      "properties": [
        {
          "id": "p1",
          "title": "params",
          "description": "{ slug: string }"
        },
        {
          "id": "p2",
          "title": "searchParams",
          "description": "{ [key: string]: string | string[] }"
        }
      ]
    },
    {
      "id": "comp-cart-btn",
      "type": "component",
      "tier": "presentation",
      "label": "AddToCartButton",
      "description": "Interactive client component managing optimistic add-to-cart animations and triggers",
      "subType": "client",
      "pos": {
        "x": 460,
        "y": 733
      },
      "properties": [
        {
          "id": "p3",
          "title": "variantId",
          "description": "string"
        },
        {
          "id": "p4",
          "title": "availableForSale",
          "description": "boolean"
        }
      ]
    },
    {
      "id": "store-cart",
      "type": "store",
      "tier": "logic",
      "label": "CartStore",
      "description": "Zustand client state manager holding active cart line items and optimistic UI state",
      "subType": "zustand",
      "pos": {
        "x": 60,
        "y": 378
      },
      "properties": [
        {
          "id": "p5",
          "title": "cart",
          "description": "Cart | null"
        },
        {
          "id": "p6",
          "title": "addItem",
          "description": "(variantId: string) => Promise<void>"
        },
        {
          "id": "p7",
          "title": "isOpen",
          "description": "boolean"
        }
      ]
    },
    {
      "id": "action-cart",
      "type": "action",
      "tier": "execution",
      "label": "addToCartAction",
      "description": "Next.js 'use server' Server Action performing authenticated cart mutations on Shopify API",
      "subType": "server-action",
      "pos": {
        "x": 460,
        "y": 490
      },
      "properties": [
        {
          "id": "p8",
          "title": "payload",
          "description": "{ cartId?: string, lines: CartItem[] }"
        },
        {
          "id": "p9",
          "title": "returns",
          "description": "Promise<ActionResult<Cart>>"
        }
      ]
    },
    {
      "id": "schema-cart",
      "type": "schema",
      "tier": "contract",
      "label": "CartItemSchema",
      "description": "Zod schema ensuring runtime type safety and serialization contracts across RSC/client boundaries",
      "subType": "zod",
      "pos": {
        "x": 460,
        "y": 265
      },
      "properties": [
        {
          "id": "p10",
          "title": "id",
          "description": "z.string().uuid()"
        },
        {
          "id": "p11",
          "title": "quantity",
          "description": "z.number().int().positive()"
        },
        {
          "id": "p12",
          "title": "cost",
          "description": "MoneySchema"
        }
      ]
    },
    {
      "id": "api-shopify",
      "type": "external",
      "tier": "infrastructure",
      "label": "ShopifyStorefrontApi",
      "description": "Shopify Storefront GraphQL endpoint handling inventory and checkout persistence",
      "tech": "graphql",
      "pos": {
        "x": 460,
        "y": 55
      },
      "properties": [
        {
          "id": "p13",
          "title": "endpoint",
          "description": "https://{shop}.myshopify.com/api/2024-01/graphql.json"
        },
        {
          "id": "p14",
          "title": "headers",
          "description": "X-Shopify-Storefront-Access-Token"
        }
      ]
    }
  ],
  "edges": [
    {
      "id": "edge-btn-page",
      "from": "comp-cart-btn",
      "to": "page-product",
      "type": "belongsTo"
    },
    {
      "id": "edge-btn-store",
      "from": "comp-cart-btn",
      "to": "store-cart",
      "type": "uses"
    },
    {
      "id": "edge-action-store",
      "from": "action-cart",
      "to": "store-cart",
      "type": "implements"
    },
    {
      "id": "edge-schema-store",
      "from": "schema-cart",
      "to": "store-cart",
      "type": "defines"
    },
    {
      "id": "edge-api-store",
      "from": "api-shopify",
      "to": "store-cart",
      "type": "injects"
    }
  ]
}